[Unit]
Description=Steamify CachyOS: a session was picked for the next login (the last pick wins; multi-user mode: log in again)
# Switches can come in bursts; never let the start rate limit stop the helper.
StartLimitIntervalSec=0

[Service]
Type=oneshot
TimeoutStartSec=60
ExecStart=/usr/local/libexec/steamify-relogin @ARGS@
